# 1. Factorial using recursion
def factorial(n):
    if n == 0 or n == 1:
        return 1
    else:
        return n * factorial(n - 1)


print("Factorial of 5:", factorial(5))


def sum_numbers(n):
    if n == 0:
        return 0
    else:
        return n + sum_numbers(n - 1)


print("Sum of numbers:", sum_numbers(5))


def fibonacci(n):
    if n == 0:
        return 0
    elif n == 1:
        return 1
    else:
        return fibonacci(n - 1) + fibonacci(n - 2)


print("Fibonacci number:", fibonacci(6))

def countdown(n):
    if n == 0:
        print("Happy New Year!")
    else:
        print(n)
        countdown(n - 1)


print("\nCountdown:")
countdown(5)


def power(base, exponent):
    if exponent == 0:
        return 1
    else:
        return base * power(base, exponent - 1)


print("\nPower:", power(2, 4))