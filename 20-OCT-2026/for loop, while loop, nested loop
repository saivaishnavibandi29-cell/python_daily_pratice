
# Multiplication Tables Using Loops

n = int(input("Enter a number: "))

# 1. For Loop
print("\n1. Multiplication Table Using For Loop")
for i in range(1, 11):
    print(n, "x", i, "=", n * i)

# 2. While Loop
print("\n2. Multiplication Table Using While Loop")
i = 1
while i <= 10:
    print(n, "x", i, "=", n * i)
    i += 1

# 3. Nested Loop
print("\n3. Multiplication Tables Using Nested Loop")
for j in range(1, n + 1):
    print("\nTable of", j)
    for i in range(1, 11):
        print(j, "x", i, "=", j * i)
