def calculate_total(m1, m2, m3):
    total = m1 + m2 + m3
    return total


def calculate_average(total, subjects=3):
    average = total / subjects
    return average


def calculate_grade(average):
    if average >= 90:
        return "A Grade"
    elif average >= 75:
        return "B Grade"
    elif average >= 60:
        return "C Grade"
    else:
        return "Fail"


def display_result(name, m1, m2, m3, subjects=3):
    total = calculate_total(m1, m2, m3)
    average = calculate_average(total, subjects)
    grade = calculate_grade(average)

    print("\n----- STUDENT RESULT -----")
    print("Student Name:", name)
    print("Subject 1 Marks:", m1)
    print("Subject 2 Marks:", m2)
    print("Subject 3 Marks:", m3)
    print("Total Marks:", total)
    print("Average Marks:", average)
    print("Grade:", grade)

display_result("Vaishu", 95, 85, 90)
display_result("Sathwik", 70, 65, 75)
display_result("Rithwik", 40, 45, 50)